HOST=0.0.0.0
PORT=4173
NOVA_DATA_DIR=/data
# Optional: set a PostgreSQL URL to share projects and sessions between instances.
DATABASE_URL=
# Optional for local mode; Render generates this secret for production.
NOVA_DATA_ENCRYPTION_KEY=
# Keep true only while migrating from an attached persistent disk.
NOVA_STORAGE_DUAL_WRITE=false
NOVA_ACCESS_USER=nova
NOVA_ACCESS_PASSWORD=replace-with-a-random-secret-at-least-20-characters
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts

# Optional paid visitor subscriptions. Leave empty until Stripe is configured.
NOVA_PUBLIC_URL=https://www.nova-ai-studio.eu
STRIPE_SECRET_KEY=
STRIPE_STANDARD_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NOVA_SUBSCRIBER_DAILY_AI_LIMIT=5

# Optional bank receipt details; alternatively configure them in /admin.html.
NOVA_BANK_IBAN=
NOVA_BANK_BENEFICIARY=

# Optional Google sign-in (OAuth client type: Web application). Leave empty to hide Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Production redirect example: https://www.nova-ai-studio.eu/api/auth/google/callback
